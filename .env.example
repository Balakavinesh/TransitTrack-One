# TransitTrack One Configuration Example
# Copy to .env for local development

# Backend API Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection
# Leave empty or set to "embedded" to use zero-config embedded PGlite database
DATABASE_URL=
# Or specify standard PostgreSQL connection:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/transittrack_one

# Security & Secrets
JWT_SECRET=your-secure-random-jwt-secret-minimum-32-chars-long!
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# Optional LLM Integration for Assistant (leave empty to use grounded rule-based tool assistant)
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_ENABLE_BACKEND=true
